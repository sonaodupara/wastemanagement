# Django Environment Configuration Example
# Copy this file to '.env' and fill in your values.

# Security
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database Configuration (Defaults to MySQL, set USE_SQLITE=True for instant setup)
USE_SQLITE=False
DB_ENGINE=django.db.backends.mysql
DB_NAME=wastedb
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306

# Google Gemini AI Integration (for AI Waste Classification)
GEMINI_API_KEY=your-google-gemini-api-key-here
